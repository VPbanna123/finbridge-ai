PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/finbridge
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email verification (Resend)
# Email_Token_Expiry accepts values such as 15m, 1h or 7d. A plain number is
# treated as minutes. Email_Token_Secret falls back to JWT_SECRET if empty.
Email_Token_Secret=
Email_Token_Expiry=1d
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cloudinary (blog images, whiteboard exports and profile photos)
# Either provide CLOUDINARY_URL or the three individual values below.
CLOUDINARY_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Gemini AI (chatbot)
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-3.8-flash
